@model TechWorldPortal.Models.LoginViewModel
@{
    ViewData["Title"] = "TechWorld Staff Login";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .login-container {
            background: white;
            border-radius: 12px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.2);
            max-width: 420px;
            width: 100%;
        }

        .login-header {
            background: #5a67d8;
            color: white;
            padding: 32px;
            text-align: center;
            border-radius: 12px 12px 0 0;
        }

            .login-header h1 {
                font-size: 1.8em;
                margin-bottom: 8px;
            }

            .login-header p {
                font-size: 0.95em;
                opacity: 0.9;
            }

        .login-body {
            padding: 32px;
        }

        .alert {
            padding: 12px 16px;
            border-radius: 4px;
            margin-bottom: 20px;
            font-size: 0.9em;
        }

        .alert-error {
            background: #FEE;
            color: #C00;
            border-left: 4px solid #C00;
        }

        .form-group {
            margin-bottom: 20px;
        }

            .form-group label {
                display: block;
                font-weight: 500;
                margin-bottom: 8px;
                color: #333;
            }

            .form-group input {
                width: 100%;
                padding: 12px;
                border: 1px solid #ccc;
                border-radius: 6px;
                font-size: 0.95em;
            }

                .form-group input:focus {
                    outline: none;
                    border-color: #5a67d8;
                    box-shadow: 0 0 0 3px rgba(90, 103, 216, 0.1);
                }

        .btn-login {
            width: 100%;
            padding: 14px;
            background: #5a67d8;
            color: white;
            border: none;
            border-radius: 6px;
            font-size: 1em;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

            .btn-login:hover {
                background: #4c51bf;
            }

        .demo-credentials {
            margin-top: 20px;
            padding: 16px;
            background: #f7fafc;
            border-radius: 6px;
            font-size: 0.85em;
        }

            .demo-credentials strong {
                display: block;
                margin-bottom: 8px;
                color: #5a67d8;
            }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-header">
            <h1>TechWorld</h1>
            <p>Staff Portal Login</p>
        </div>

        <div class="login-body">
            @if (TempData["Error"] != null)
            {
            <div class="alert alert-error">
                @TempData["Error"]
            </div>
            }

            <form method="post" asp-action="Login">
                <div class="form-group">
                    <label for="Username">Username</label>
                    <input type="text" id="Username" name="Username" required autofocus>
                </div>

                <div class="form-group">
                    <label for="Password">Password</label>
                    <input type="password" id="Password" name="Password" required>
                </div>

                <button type="submit" class="btn-login">Login to Portal</button>
            </form>

            <div class="demo-credentials">
                <strong>Demo Credentials:</strong>
                Username: techworld_staff<br>
                Password: tech123
            </div>
        </div>
    </div>
</body>
</html>